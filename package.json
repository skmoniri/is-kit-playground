{
  "name": "is-kit-playground",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "generate:typecheck": "node scripts/generate-typecheck-libs.mjs",
    "predev": "npm run generate:typecheck",
    "dev": "vite",
    "prebuild": "npm run generate:typecheck",
    "build": "tsc -b && vite build",
    "build:sandbox": "vite build --config sandbox/vite.config.ts",
    "lint": "eslint .",
    "test": "node --test scripts/test-typecheck.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "is-kit": "^1.16.5",
    "lucide-react": "^1.73.0",
    "lz-string": "^1.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6"
  }
